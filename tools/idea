#!/usr/bin/env bash
# Open IntelliJ IDEA Community on this project inside the Nix dev shell.
set -euo pipefail

repo="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

if [[ -z "${JAVA_HOME:-}" ]]; then
    if command -v nix >/dev/null 2>&1 && [[ -f "$repo/flake.nix" ]]; then
        exec nix develop "$repo" -c "${BASH_SOURCE[0]}" "$@"
    fi
    echo "JAVA_HOME is unset; enter the nix shell first: nix develop $repo" >&2
    exit 1
fi

if command -v resounding-idea >/dev/null 2>&1; then
    exec resounding-idea "$@"
fi

if command -v idea-community >/dev/null 2>&1; then
    exec idea-community "$repo" "$@"
fi

echo "idea-community not found; enter the nix shell: nix develop $repo" >&2
exit 1
